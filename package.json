    "@types/node": "^22.20.5",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.7",
    "@wxt-dev/module-react": "^1.1.3",
    "esbuild": "^0.25.12",
    "happy-dom": "^20.14.6",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
